# Required
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# SEC EDGAR (no key needed — provide a real email for the User-Agent header)
EDGAR_USER_AGENT=FinancialResearchAgent your@email.com

# Optional: override default model names
PRIMARY_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant

# Storage paths (defaults shown)
CHROMA_PERSIST_DIR=data/chroma_db
SEC_FILINGS_DIR=data/sec_filings

# Hard-gate thresholds (Article 3 defaults)
MIN_HEALTH_SCORE=50.0
MIN_GROWTH_SCORE=50.0
MIN_DAILY_LIQUIDITY=500000
MAX_ANALYST_COVERAGE=15
